<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>views_key</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@viewsCount@</string>
        <key>viewsCount</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>zero</key>
            <string>%d views</string>
            <key>one</key>
            <string>%d view</string>
            <key>other</key>
            <string>%d views</string>
        </dict>
    </dict>
	<key>likes_key</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@likesCount@</string>
		<key>likesCount</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>no likes</string>
			<key>one</key>
			<string>one like</string>
			<key>other</key>
			<string>%d likes</string>
		</dict>
	</dict>
</dict>
</plist>
